# Copy to .env and adjust for local development.
# Never commit .env.

# Infra services (docker-compose.yml)
POSTGRES_PASSWORD=tk_dev_password
MINIO_ROOT_USER=tk_minio
MINIO_ROOT_PASSWORD=tk_minio_password

# API (services/api) — TK_ prefix
TK_ENV=dev
TK_LOG_LEVEL=INFO
TK_DATABASE_URL=postgresql+asyncpg://tk:tk_dev_password@127.0.0.1:5434/theek_karo
TK_CORS_ORIGINS=["http://localhost:3000"]
TK_OTEL_ENABLED=false
TK_OTEL_ENDPOINT=http://localhost:4318

# Phase 16 auth hardening
# MFA (TOTP) for privileged roles — mandatory true in prod/staging.
TK_MFA_ENFORCE_PRIVILEGED=false
TK_MFA_REQUIRED_ROLES=["super_admin","admin","moderator","department_manager","reviewer","official","analyst","department_representative","institution_representative"]
TK_MFA_CHALLENGE_TTL_SECONDS=300
TK_MFA_MAX_ATTEMPTS=5
TK_MFA_BACKOFF_SECONDS=60
# Per-account login backoff / lockout
TK_LOGIN_MAX_FAILURES=5
TK_LOGIN_BACKOFF_BASE_SECONDS=60
TK_LOGIN_BACKOFF_MAX_SECONDS=3600
TK_LOGIN_FAILURE_WINDOW_SECONDS=300

# Media storage (Step 7 — object storage security)
TK_MEDIA_STORAGE_MODE=local            # local | memory | minio
TK_MEDIA_MAX_SIZE_MB=8
TK_MEDIA_ALLOWED_MIME=["image/jpeg","image/png","image/webp"]
TK_MEDIA_LOCAL_DIR=./media/tk-media
TK_MEDIA_MINIO_ENDPOINT=127.0.0.1:9000
# Endpoint reachable by client browsers (presigned URLs). For AWS S3 use
# s3.<region>.amazonaws.com; region + TLS must match the bucket.
TK_MEDIA_MINIO_PUBLIC_ENDPOINT=127.0.0.1:9000
TK_MEDIA_MINIO_REGION=us-east-1
TK_MEDIA_MINIO_SECURE=false
TK_MEDIA_MINIO_ACCESS_KEY=tk_minio
TK_MEDIA_MINIO_SECRET_KEY=tk_minio_password
TK_MEDIA_MINIO_BUCKET=tk-media

# Database connection pool (Step 9)
TK_DB_POOL_SIZE=10
TK_DB_MAX_OVERFLOW=20
TK_DB_POOL_RECYCLE_SECONDS=1800

# AI safety (Step 12) — daily chat spend cap per user/IP
TK_AI_DAILY_CHAT_LIMIT=300

# Phase 15 — community confirmation on resolved cases (PRD §B.2)
# Thresholds for the two-confirmer gate and the "issue still exists" reopen
# signal. Signals are review triggers; they never auto-close/reopen a case.
TK_RESOLUTION_CONFIRM_THRESHOLD=2
TK_RESOLUTION_REOPEN_THRESHOLD=3

# Phase 19 — government interoperability & data integration
# Connector circuit breaker: fail-fast after N consecutive failures, cooldown
# before the connector may be probed again.
TK_CONNECTOR_FAILURE_THRESHOLD=3
TK_CONNECTOR_COOLDOWN_SECONDS=300
TK_CONNECTOR_FRESHNESS_GRACE_HOURS=48
# Outgoing webhook HMAC signing. The per-subscription key is derived from this
# master secret + the subscription's secret_key_id; the raw secret is never
# stored. PRODUCTION MUST SET TK_WEBHOOK_MASTER_SECRET (readiness check enforces).
TK_WEBHOOK_MASTER_SECRET=dev-webhook-secret-change-me
TK_WEBHOOK_MAX_ATTEMPTS=5
TK_WEBHOOK_BASE_DELAY_SECONDS=30
TK_WEBHOOK_TIMEOUT_SECONDS=10
# Default cadence for connector syncs without an explicit frequency.
TK_INTEGRATIONS_DEFAULT_SYNC_HOURS=24
